# Freevibes configuration. Copy to .env and adjust as needed.
# Every value below is a default; none are required.

# Only supported mode. Free Meta Vibes generation, no paid providers.
FREEVIBES_MODE=free-meta-vibes

# Paid providers are refused at startup. Leave this false.
ALLOW_PAID_PROVIDERS=false

# Provider id. meta-vibes-free reports BLOCKED until a legitimate route exists.
FREEVIBES_PROVIDER=meta-vibes-free

# Where the SQLite database and staging files live.
# FREEVIBES_DATA_DIR=~/.freevibes

# Where finished media is written.
# FREEVIBES_ASSET_DIR=~/.freevibes/assets

# Per-asset download ceiling, in bytes (default 512 MiB).
# FREEVIBES_MAX_DOWNLOAD_BYTES=536870912

# Per-download timeout, in milliseconds.
# FREEVIBES_DOWNLOAD_TIMEOUT_MS=120000

# How long to wait for a provider job before giving up.
# FREEVIBES_JOB_TIMEOUT_MS=600000

# How long another process's job may go without a heartbeat before startup
# recovery treats it as abandoned. Defaults to 60s beyond the job timeout.
# FREEVIBES_JOB_STALE_MS=660000

# Comma-separated host suffixes permitted for downloads. Empty means any host.
# FREEVIBES_DOWNLOAD_HOST_ALLOWLIST=

# debug | info | warn | error | silent. Logs always go to stderr.
FREEVIBES_LOG_LEVEL=info
