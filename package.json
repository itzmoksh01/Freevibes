{
  "name": "freevibes",
  "version": "0.2.0",
  "description": "Universal MCP bridge for AI image and video generation from MCP-compatible coding agents.",
  "license": "Apache-2.0",
  "author": "Freevibes contributors",
  "homepage": "https://github.com/itzmoksh01/Freevibes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itzmoksh01/Freevibes.git"
  },
  "bugs": {
    "url": "https://github.com/itzmoksh01/Freevibes/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "freevibes": "dist/install/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "scripts",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test && npm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "better-sqlite3": "^11.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "video-generation",
    "image-generation",
    "claude-code",
    "codex",
    "zed",
    "muse-code"
  ]
}
